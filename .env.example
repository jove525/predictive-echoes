# PredictiveEchoes — Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here

# Pexels (free stock footage)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay (free stock footage backup)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Kling AI (paid video generation — optional, set FOOTAGE_SOURCE=kling+pexels to enable)
KLING_API_KEY=your_kling_api_key_here
KLING_API_SECRET=your_kling_api_secret_here

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_CHANNEL_ID=your_channel_id_here

# OpenAI (for Whisper subtitles + DALL-E thumbnails)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Telegram bot for approval notifications (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
